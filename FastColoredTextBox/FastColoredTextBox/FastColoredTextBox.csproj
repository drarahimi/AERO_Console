<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FastColoredTextBoxNS</RootNamespace>
    <AssemblyName>FastColoredTextBox</AssemblyName>
    <!-- Keep the hand-maintained Properties\AssemblyInfo.cs as the source of assembly metadata. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>FCTB_key.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Vendored third-party control: silence benign XML-doc / member-hiding warnings,
         the WinForms designer-serialization analyzer (WFO1000), which fires on the many
         upstream properties that intentionally lack DesignerSerializationVisibility, and
         CA1416 platform warnings (this is an inherently Windows-only WinForms control). -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1574;CS1584;CS1658;CS0108;WFO1000;CA1416</NoWarn>
  </PropertyGroup>

</Project>
