<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <StartupObject>AERO_Console.My.MyApplication</StartupObject>
    <MyType>WindowsForms</MyType>
    <PublishUrl>publish\</PublishUrl>
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <UpdateEnabled>false</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <UpdatePeriodically>false</UpdatePeriodically>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <ApplicationRevision>0</ApplicationRevision>
    <ApplicationVersion>1.0.0.%2a</ApplicationVersion>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <UseApplicationTrust>false</UseApplicationTrust>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>True</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <SignManifests>true</SignManifests>
    <AssemblyTitle>AERO Console</AssemblyTitle>
    <Description>This GUI is made available by Dr. Afshin Rahimi from the University of Windsor in Windsor, ON, Canada for students in the course MECH-4671 Aerodynamics and Performance to explore Mark Drela%27s AVL and Xfoil software in a friendlier interface and work through their assignments and project.</Description>
    <Product>AERO Console</Product>
    <Copyright>Copyright ©2020</Copyright>
    <NeutralLanguage>en-CA</NeutralLanguage>
    <ApplicationManifest>My Project\app.manifest</ApplicationManifest>
    <OptionStrict>On</OptionStrict>
    <AssemblyVersion>1.7.0.0</AssemblyVersion>
    <FileVersion>1.7.0.0</FileVersion>
    <AssemblyName>$(MSBuildProjectName.Replace("_", " "))</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(ProjectDir)**\*.vb</DefaultItemExcludes>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Suppress benign warnings carried over from the VB->C# conversion:
         doc-comment (1591,1573,1572,1574,1584), unused locals/fields (0168,0169,0219,0414,0649),
         member hiding (0108) and obsolete WinForms Closing events (WFDEV004). -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1574;CS1584;CS0168;CS0169;CS0219;CS0414;CS0649;CS0108;WFDEV004</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="frmAbout.Designer.cs">
      <DependentUpon>frmAbout.cs</DependentUpon>
    </Compile>
    <Compile Update="frmGeometry.Designer.cs">
      <DependentUpon>frmGeometry.cs</DependentUpon>
    </Compile>
    <Compile Update="frmHelp.Designer.cs">
      <DependentUpon>frmHelp.cs</DependentUpon>
    </Compile>
    <Compile Update="frmInfo.Designer.cs">
      <DependentUpon>frmInfo.cs</DependentUpon>
    </Compile>
    <Compile Update="frmUpdate.Designer.cs">
      <DependentUpon>frmUpdate.cs</DependentUpon>
    </Compile>
    <Compile Update="My Project\Application.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="My Project\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="My Project\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Include="bin\Debug\appdata.dat" />
    <None Include="bin\Debug\appdatafiles\appdata.dat" />
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.cs</LastGenOutput>
    </None>
    <None Update="My Project\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Include="bin\Debug\FastColoredTextBox.dll" />
    <Content Include="logo.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FastColoredTextBox\FastColoredTextBox\FastColoredTextBox.csproj" />
    <ProjectReference Include="..\Avl.Core\Avl.Core.csproj" />
  </ItemGroup>
</Project>